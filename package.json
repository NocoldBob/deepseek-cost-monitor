{
  "name": "deepseek-cost-monitor",
  "displayName": "DeepSeek Cost Monitor",
  "description": "在 VS Code 侧边栏查看今日与历史 DeepSeek API 估算消费（基于 Claude Code 本地会话记录）",
  "version": "0.2.0",
  "publisher": "NocoldBob",
  "license": "MIT",
  "icon": "resources/icon-options/whale-chart.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NocoldBob/deepseek-cost-monitor.git"
  },
  "homepage": "https://github.com/NocoldBob/deepseek-cost-monitor#readme",
  "bugs": {
    "url": "https://github.com/NocoldBob/deepseek-cost-monitor/issues"
  },
  "scripts": {
    "package": "vsce package",
    "package:marketplace": "vsce package --readme-path MARKETPLACE.md",
    "publish:marketplace": "vsce publish --readme-path MARKETPLACE.md",
    "check": "node tools/extension_check.js",
    "test": "node --test"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "deepseek api",
    "cost",
    "cost monitor",
    "billing",
    "usage",
    "tokens",
    "history",
    "statistics",
    "heatmap",
    "claude code",
    "vscode-extension"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekCostMonitor",
          "title": "DeepSeek 消费",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "deepseekCostMonitor": [
        {
          "id": "deepseekCostMonitor.today",
          "name": "消费统计",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekCostMonitor.refresh",
        "title": "刷新 DeepSeek 消费",
        "category": "DeepSeek",
        "icon": "$(refresh)"
      },
      {
        "command": "deepseekCostMonitor.focus",
        "title": "打开 DeepSeek 消费面板",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekCostMonitor.showDiagnostics",
        "title": "输出诊断与自检信息",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekCostMonitor.rebuildLedger",
        "title": "从日志重建账本",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekCostMonitor.clearLedger",
        "title": "清除历史账本",
        "category": "DeepSeek"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepseekCostMonitor.refresh",
          "when": "view == deepseekCostMonitor.today",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek 消费监控",
      "properties": {
        "deepseekCostMonitor.projectsPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Claude Code 会话记录根目录。留空使用 ~/.claude/projects。"
        },
        "deepseekCostMonitor.modelPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "deepseek"
          ],
          "scope": "window",
          "description": "计入统计的模型名前缀（不区分大小写）。"
        },
        "deepseekCostMonitor.currency": {
          "type": "string",
          "enum": [
            "CNY",
            "USD"
          ],
          "default": "CNY",
          "scope": "window",
          "description": "金额展示币种，按 DeepSeek 官方对应币种价目计算。"
        },
        "deepseekCostMonitor.rateOverrides": {
          "type": "object",
          "default": {},
          "scope": "window",
          "description": "按模型覆盖高峰单价（每百万 token），形如 {\"模型\":{\"CNY\":{\"cacheHit\":0.04,\"cacheMiss\":2,\"output\":8}}}。低谷价始终为高峰价的一半。"
        },
        "deepseekCostMonitor.holidays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "自定义法定节假日日期（YYYY-MM-DD，北京时间），这些日期按低谷计价。留空使用内置表（2024–2027，随版本更新）；填写后整体替代内置表。"
        },
        "deepseekCostMonitor.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 3600,
          "scope": "window",
          "description": "定时刷新间隔（秒）。文件变化仍会立即触发刷新。"
        },
        "deepseekCostMonitor.includeSubagents": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否统计子代理产生的请求。"
        },
        "deepseekCostMonitor.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否在状态栏显示今日消费。"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1"
  }
}
